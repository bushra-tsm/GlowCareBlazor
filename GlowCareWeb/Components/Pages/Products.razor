@page "/"
@rendermode InteractiveServer

@using GlowCareWeb.Models
@using GlowCareWeb.Components.Shared
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims;


@inject IJSRuntime JSRuntime
@inject GlowCareDbContext db
@inject IWebHostEnvironment Environment
@inject NavigationManager Navigation
@inject GlowCareWeb.Services.NotificationService NotificationService
@if (isAdmin)
{
    <h3 class="text-center">Products Management</h3>

    <h4>Add Product</h4>
    <EditForm Model="AddProduct" OnValidSubmit="AddProducts" FormName="AddProduct">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Product Name</label>
            <InputText @bind-Value="AddProduct.ProductName" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Category</label>
            <InputSelect @bind-Value="AddProduct.CategoryId" class="form-select">
                <option value="0">-- Select Category --</option>

                @foreach (var item in categories)
                {
                    <option value="@item.CategoryId">@item.CategoryName</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label>Price</label>
            <InputNumber @bind-Value="AddProduct.Price" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Stock</label>
            <InputNumber @bind-Value="AddProduct.Stock" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Product Image</label>
            <InputFile OnChange="UploadPhoto" class="form-control" />
        </div>

        @if (!string.IsNullOrEmpty(AddProduct.PhotoPath))
        {
            <div class="mb-3">
                <img src="@AddProduct.PhotoPath"
                     width="120"
                     class="img-thumbnail" />
            </div>
        }

        <div class="form-check mb-3">
            <InputCheckbox @bind-Value="AddProduct.IsActive" class="form-check-input" />
            <label class="form-check-label">Active</label>
        </div>

        <button class="btn btn-primary">Save Product</button>
    </EditForm>
    <br />
    <br />

  @*   Search Box *@
    <div class="row mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="input-group product-search-box">
                <span class="input-group-text product-search-icon">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text"
                       class="form-control product-search-input"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Search by product or category..." />

                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <button class="btn product-search-clear-btn"
                            @onclick="() => searchText = string.Empty"
                            title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>
    </div>


    <h4>Products List</h4>
    <hr />
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>SL</th>
                <th>Image</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @{
                int sl = 1;
            }

          @foreach(var item in SearchProducts())
            {
                <tr>
                    <td>@(sl++)</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.PhotoPath))
                        {
                            <img src="/@item.PhotoPath"
                                 width="150"
                                 height="150"
                                 class="img-thumbnail" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                    </td>

                    <td>@item.ProductName</td>

                    <td>@item.Category.CategoryName</td>

                    <td>@item.Price</td>

                    <td>@item.Stock</td>

                    <td>
                        @if (item.IsActive == true)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>

                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => EditProducts(item)">
                            Edit
                        </button>

                        <button class="btn btn-danger btn-sm ms-2" @onclick="() => DeleteProducts(item.ProductId)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>


    @if (IsEdit)
    {
        <h4>Update Product</h4>
        <EditForm Model="EditProduct" OnValidSubmit="UpdateProduct" FormName="UpdateProducts">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label>Product Name</label>
                <InputText @bind-Value="EditProduct.ProductName" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Category</label>
                <InputSelect @bind-Value="EditProduct.CategoryId" class="form-select">
                    <option value="0">-- Select Category --</option>

                    @foreach (var item in categories)
                    {
                        <option value="@item.CategoryId">@item.CategoryName</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label>Price</label>
                <InputNumber @bind-Value="EditProduct.Price" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Stock</label>
                <InputNumber @bind-Value="EditProduct.Stock" class="form-control" />
            </div>

            <div class="mb-3">
                <label>Product Image</label>
                <InputFile OnChange="UploadPhoto" class="form-control" />
            </div>

            @if (!string.IsNullOrEmpty(EditProduct.PhotoPath))
            {
                <div class="mb-3">
                    <img src="@EditProduct.PhotoPath"
                         width="120"
                         class="img-thumbnail" />
                </div>
            }

            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="EditProduct.IsActive" class="form-check-input" />
                <label class="form-check-label">Active</label>
            </div>

            <button class="btn btn-primary">Update Product</button>
        </EditForm>
    }
}



@* For user *@

else
{

    
    @* Search Box + Cart Row *@
    <div class="row mb-4 align-items-center product-toolbar">
        <div class="col-md-6 col-lg-4">
            <div class="input-group product-search-box">
                <span class="input-group-text product-search-icon">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text"
                       class="form-control product-search-input"
                       @bind="searchText"
                       @bind:event="oninput"
                       placeholder="Search by product or category..." />

                       @*to clear if searchText not empty *@
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <button class="btn product-search-clear-btn"
                            @onclick="() => searchText = string.Empty"
                            title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>
        </div>

        <div class="col-md-6 col-lg-8 d-flex justify-content-end mt-3 mt-md-0">
            <button class="btn glowcare-btn position-relative"
                    @onclick='() => Navigation.NavigateTo("/cart")'>

                🛒 Cart

                @if (cartItems.Count > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @cartItems.Count
                    </span>
                }

            </button>
        </div>
    </div>

    <h3>Products</h3>

    <div class="row">
        @foreach (var item in SearchProducts().Where(p => p.IsActive))
        {
            <div class="col-md-3 mb-3">
                <div class="card">

                    <img src="@item.PhotoPath" class="card-img-top" />

                    <div class="card-body">
                        <h5>@item.ProductName</h5>
                        <strong>Price:</strong> @item.Price <br />
                        <strong>Category:</strong> @item.Category.CategoryName
                        <br /><br />

                        <button class="btn glowcare-btn"
                                @onclick="() => AddToCart(item)">
                            Add to Cart
                        </button>

                    </div>

                </div>
            </div>
        }
    </div>
}






@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private bool isAdmin;
    private string userId = "";
    private string searchText = "";

    List<Product> products = new();
    List<Category> categories = new();
    List<CartItem> cartItems = new();

    Product AddProduct = new();
    Product EditProduct = new();
    bool IsEdit = false;

   
    

    private IEnumerable<Product> SearchProducts()

    {

        if (string.IsNullOrWhiteSpace(searchText))

            return products;

        var keyword = searchText.Trim().ToLower();

        return products.Where(p =>

        (p.ProductName ?? "").ToLower().Contains(keyword) ||

        (p.Category?.CategoryName ?? "").ToLower().Contains(keyword));

    }


    private async Task LoadCart()
    {
        var userCart = await GetOrCreateCart();

        cartItems = await db.CartItems
            .Include(x => x.Product)
            .Where(x => x.CartId == userCart.CartId)
            .ToListAsync();
    }


    private async Task<Cart> GetOrCreateCart()
    {
        var cart = await db.Carts
            .Include(c => c.CartItems)
            .FirstOrDefaultAsync(c => c.UserId == userId && c.Status == "Active");

        if (cart == null)
        {
            cart = new Cart
            {
                UserId = userId,
                Status = "Active",
                CreatedDate = DateTime.Now
            };

            db.Carts.Add(cart);
            await db.SaveChangesAsync();
        }

        return cart;
    }

 




    private async Task AddToCart(Product product)
    {
        var user = (await AuthenticationStateTask).User;

        if (!(user.Identity?.IsAuthenticated ?? false))
        {
            NotificationService.Error("You Need to Login");
            await Task.Delay(300);
            Navigation.NavigateTo("/Account/Login");
            return;
        }

        userId = user.FindFirstValue(ClaimTypes.NameIdentifier)!;

        var cart = await GetOrCreateCart();

        var existingItem = await db.CartItems
            .FirstOrDefaultAsync(x =>
                x.CartId == cart.CartId &&
                x.ProductId == product.ProductId);

        int currentQtyInCart = existingItem?.Quantity ?? 0;
        int newQty = currentQtyInCart + 1;

        if (newQty > product.Stock)
        {
            NotificationService.Warning($"Only {product.Stock} in stock. You already have {currentQtyInCart} in your cart.");
            return;
        }
        // It increase cart
        if (existingItem != null)
        {
            existingItem.Quantity++;
        }
        else
        {
            db.CartItems.Add(new CartItem
            {
                CartId = cart.CartId,
                ProductId = product.ProductId,
                Quantity = 1,
                UnitPrice = product.Price
            });
        }

        await db.SaveChangesAsync();
        NotificationService.Success("Added To Cart");

        await LoadCart();

        StateHasChanged();
    }




    public async Task DeleteProducts(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this item?");

        if (confirmed)
        {
            // Execute your delete logic here
            await ConfirmDelete(id);
        }
    }

 

    public async Task ConfirmDelete(int id)
    {
        var pd = await db.Products.FindAsync(id);
        if (pd != null)
        {
            db.Products.Remove(pd);
            await db.SaveChangesAsync();
            NotificationService.Warning("Product deleted");
            products = await db.Products
                .Include(p => p.Category)
                .ToListAsync();
        }
    }

    public async Task UpdateProduct()
    {
        var s = db.Products.Find(EditProduct.ProductId);
        if (s != null)
        {
            s.ProductId = EditProduct.ProductId;
            s.ProductName = EditProduct.ProductName;
            s.PhotoPath = EditProduct.PhotoPath;
            s.Price = EditProduct.Price;
            s.Stock = EditProduct.Stock;
            s.IsActive = EditProduct.IsActive;

            // Auto-reactivate if restocked, auto-deactivate if emptied
            if (s.Stock > 0 && !s.IsActive)
            {
                s.IsActive = true;
            }
            else if (s.Stock <= 0)
            {
                s.IsActive = false;
            }

            await db.SaveChangesAsync();
            NotificationService.Info("Updated successfully");
            EditProduct = new();
            IsEdit = false;
            products = await db.Products
            .Include(p => p.Category)
            .ToListAsync();
        }
    }


    public void EditProducts(Product pd)
    {
        EditProduct = new()
        {
            ProductId = pd.ProductId,
            ProductName = pd.ProductName,
            Stock = pd.Stock,
            CategoryId = pd.CategoryId,
            IsActive = pd.IsActive,
            PhotoPath = pd.PhotoPath
        };
        IsEdit = true;

    }

    private async Task UploadPhoto(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        var fileName = Guid.NewGuid().ToString() + Path.GetExtension(file.Name);

        var folder = Path.Combine(Environment.WebRootPath, "images", "products");

        Directory.CreateDirectory(folder);

        var filePath = Path.Combine(folder, fileName);

        using FileStream fs = new(filePath, FileMode.Create);

        await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);

        AddProduct.PhotoPath = $"images/products/{fileName}";
    }

    private async Task AddProducts()
    {
        db.Products.Add(AddProduct);

        await db.SaveChangesAsync();
        NotificationService.Success("Added successfully");

        AddProduct = new();
        products = await db.Products
          .Include(p => p.Category)
          .ToListAsync();

        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;

        isAdmin = user.Identity?.IsAuthenticated == true &&
                  user.IsInRole("Admin");

        if (user.Identity?.IsAuthenticated == true && !isAdmin)
        {
            userId = user.FindFirstValue(ClaimTypes.NameIdentifier)!;
            await LoadCart();
        }

        categories = await db.Categories.ToListAsync();

        products = isAdmin
            ? await db.Products.Include(p => p.Category).ToListAsync()
            : await db.Products
                .Where(p => p.IsActive)
                .Include(p => p.Category)
                .ToListAsync();
    }
}